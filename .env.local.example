# ====================================================================
# Voltair Tech site — RAG chatbot + blog + inquiries configuration.
# Copy to .env.local (gitignored) and fill in. On Vercel, set these as
# Project → Settings → Environment Variables. All are SERVER-SIDE only —
# none are exposed to the browser, so do NOT prefix with NEXT_PUBLIC_.
# ====================================================================

# --- Supabase (the NEW Voltair project — separate from Kauntech) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role / sb_secret key — server-side only, NEVER ship to the browser.
SUPABASE_SERVICE_KEY=your-service-role-or-sb_secret-key

# --- Gemini (https://aistudio.google.com/apikey) — NEW Voltair key ---
GOOGLE_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown):
# LLM_MODEL=gemini-2.5-flash             # 2.0-flash is blocked for new keys; 2.5-flash works
# LLM_ANALYTICS_MODEL=gemini-2.5-flash-lite  # cheaper model for background lead analytics; set to gemini-2.5-flash if a key lacks lite
# LLM_TEMPERATURE=0.6
# LLM_MAX_OUTPUT_TOKENS=700              # caps the priciest (output) tokens; normal replies are ~300
# EMBEDDING_MODEL=gemini-embedding-001   # text-embedding-004 not available on newer keys
# EMBEDDING_DIM=768                      # must match vector(N) in migrations/0001_init.sql

# --- RAG tuning (optional) ---
# RAG_TOP_K=6                            # set 4–5 to cut input cost further (slight recall trade-off)
# RAG_MIN_SIMILARITY=0.3
# HISTORY_WINDOW=8                       # turns of memory kept; lower = cheaper on long chats

# --- Admin key: protects POST/GET /api/ingest + /api/blog + /api/revalidate.
#     Must EQUAL the admin panel's VOLTAIR_ADMIN_KEY. Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-string
